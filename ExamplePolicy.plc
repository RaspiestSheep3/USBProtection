IF [ ~OWNER~ = #TEST1# ] {
    IF [ ~SYSTEM_MODE~ = #1# ] {
        :REQUEST:
    }
    EL {
        :DENY:
    }
}
EL {
    IF [ ~KNOWN~ = #true# ] {
        IF [ ~TIME~ < #20:00:00#] {
            :ACCEPT:
        }
        EL {
            :DENY:
        }
    }
    EL {
        IF [ ~VID~ = #1234#] {
            :REQUEST:
        }

        EL {
            IF[ ~PID~ = #1234# ] {
                :ACCEPT:
            }
        }
    }
}